  function normalizeLegacy(it){if(!it||typeof it!=='object')return null;const typeMap={shirt:SHIRT,pants:BOTTOM,shoes:SHOE,hoodie:OUTER};const source=it.originalImg||it.img||it.image;if(!validImage(source))return null;return{id:String(it.id||id()),name:String(it.name||'').slice(0,80),type:TYPES.includes(it.type)?it.type:typeMap[it.category]||SHIRT,fit:EVENTS.includes(it.fit)?it.fit:'יום רגיל',wx:WEATHER.includes(it.wx)?it.wx:ALL_WX,img:validImage(it.img||it.image)?(it.img||it.image):source,originalImg:source,createdAt:Number(it.createdAt)||Date.now(),aiStatus:'off'}}
  async function initStorage(){
