  async function handleFiles(fileList){const files=Array.from(fileList||[]);if(!files.length)return;const metadata={type:selected('type'),fit:selected('fit'),wx:selected('wx'),useAI:$('removeBg').checked};saveCount+=files.length;saveStatus('שומר '+saveCount+' תמונות…');ingestChain=ingestChain.then(async()=>{await ready;for(const file of files){try{const image=await normalizePhoto(file);const item={id:id(),name:'',type:metadata.type,fit:metadata.fit,wx:metadata.wx,img:image,originalImg:image,createdAt:Date.now(),aiStatus:metadata.useAI?'pending':'off'};await put(item);lastPhotoId=item.id;await refresh();$('preview').hidden=false;saveStatus('נשמר אוטומטית בארון ✓'+(metadata.useAI?' עיבוד הרקע מתבצע בנפרד.':''));if(metadata.useAI)queueBackground(item.id);toast('הבגד נשמר אוטומטית בארון ✓')}catch(e){console.error(e);saveStatus(e.name==='QuotaExceededError'?'אין מספיק מקום. התמונה לא נשמרה; יצאו גיבוי ופנו מקום.':e.message);toast('התמונה לא נשמרה: '+e.message)}finally{saveCount--}}}).catch(e=>{saveCount=0;saveStatus(e.message)});return ingestChain}
  function updatePreview(){const item=items.find(x=>x.id===lastPhotoId);if(!item){$('preview').hidden=true;$('photoActions').hidden=true;return}$('preview').hidden=false;$('previewImg').src=item.img;$('previewImg').alt=item.type;$('busy').hidden=!['pending','processing'].includes(item.aiStatus);$('busy').textContent='נשמר ✓ עיבוד AI ברקע…';$('photoActions').hidden=false;$('visionSuggestion').textContent=item.aiVision?'הצעת AI: '+item.aiVision.type+' · אפשר לקבל או לבחור סוג אחר.':'';$('acceptVision').hidden=!item.aiVision||item.aiVision.type===item.type;$('retryPhoto').hidden=item.aiStatus!=='error';$('photoError').textContent=item.aiError||''}

  function renderCloset(){const filter=document.querySelector('#filter .chip.on')?.dataset.f||'הכל';const list=items.filter(x=>filter==='הכל'||x.type===filter);$('count').textContent=items.length;if(!list.length){$('grid').innerHTML='<div class="empty"><div class="ring"><svg width="28" height="28"><use href="#i-hanger"/></svg></div><p>'+(items.length?'אין בגדים בקטגוריה הזו':'הארון ריק. בחרו סוג בגד ואז צלמו או העלו תמונה.')+'</p></div>';return}
    const state={done:'רקע טושטש ב-AI',pending:'נשמר · ממתין ל-AI',processing:'נשמר · AI מעבד',error:'נשמר · המקור זמין',off:'נשמר בארון'};
    $('grid').innerHTML=list.map(it=>'<article class="item"><img src="'+esc(it.img)+'" alt="'+esc(it.name||it.type)+'"><button class="x" data-delete="'+esc(it.id)+'" aria-label="מחיקת '+esc(it.name||it.type)+'"><svg width="14" height="14"><use href="#i-x"/></svg></button><div class="item-info"><strong>'+esc(it.name||it.type)+'</strong><small>'+esc(state[it.aiStatus]||state.off)+'</small><div class="item-actions"><button data-edit="'+esc(it.id)+'">עריכה</button>'+(it.aiStatus==='error'?'<button data-retry="'+esc(it.id)+'">נסה AI שוב</button>':'')+(it.aiStatus==='done'?'<button data-original="'+esc(it.id)+'">מקור / טשטוש</button>':'')+'</div></div></article>').join('')}
  async function retry(itemId){let item=(await getAll()).find(x=>x.id===itemId);if(!item)return;await put({...item,aiStatus:'pending',aiError:''});await refresh();queueBackground(itemId)}

  async function classifyItem(itemId){let item=(await getAll()).find(x=>x.id===itemId);if(!item)return null;if(item.aiVision?.version===1)return item.aiVision;status('מנתח בגד בעזרת מודל זיהוי…');const scores=await runAI('classify',item.originalImg||item.img);const scoreMap=Object.fromEntries(scores.map(x=>[x.label,x.score]));const top=(labels)=>labels.reduce((a,b)=>(scoreMap[a]||0)>(scoreMap[b]||0)?a:b);const aiVision={version:1,type:TYPES[typeLabels.indexOf(top(typeLabels))],eventScores:eventLabels.map(x=>scoreMap[x]||0),weatherScores:weatherLabels.map(x=>scoreMap[x]||0)};item=(await getAll()).find(x=>x.id===itemId);if(item)await put({...item,aiVision});await refresh();return aiVision}
  function pick(type,event,weather,useAI){const pool=items.filter(x=>x.type===type);if(!pool.length)return null;const value=item=>{const explicit=(item.fit===event?.35:0)+(item.wx===weather?.2:item.wx===ALL_WX?.1:0);if(!useAI||!item.aiVision)return explicit;const v=item.aiVision,es=v.eventScores,ws=v.weatherScores;return explicit+(es[EVENTS.indexOf(event)]||0)/Math.max(.0001,...es)+(ws[weather==='חם'?0:1]||0)/Math.max(.0001,...ws)*.4};const sorted=pool.map(item=>({item,score:value(item)})).sort((a,b)=>b.score-a.score);if(useAI)return sorted[0].item;const best=sorted.filter(x=>x.score===sorted[0].score);return best[Math.floor(Math.random()*best.length)].item}
  async function buildOutfit(useAI=false){await ready;const btn=useAI?$('smart'):$('make');btn.disabled=true;try{if(useAI){if(!items.length){toast('הוסיפו בגדים לפני הפעלת הסטייליסט');return}let n=0;const pending=items.filter(x=>!x.aiVision);for(const item of pending){$('outfitNote').textContent='ה-AI מנתח את תמונות הארון: '+(++n)+' מתוך '+pending.length;await classifyItem(item.id)}}const event=selected('event'),weather=selected('weather'),parts=[SHIRT,BOTTOM,SHOE];if(weather==='קר')parts.push(OUTER);look=parts.map(type=>({type,item:pick(type,event,weather,useAI)}));$('outfit').innerHTML=look.map(p=>'<div class="slot">'+(p.item?'<img src="'+esc(p.item.img)+'" alt="'+esc(p.type)+'"><span>'+esc(p.type)+'</span>':'חסר: '+esc(p.type))+'</div>').join('');const missing=look.filter(x=>!x.item).map(x=>x.type);$('outfitNote').textContent=missing.length?'להופעה מלאה חסרים: '+missing.join(', '):(useAI?'ה-AI דירג את התמונות לפי האירוע ומזג האוויר. ':'')+'לוק ל'+event+', מזג אוויר '+weather;status(useAI?'הסטייליסט סיים לנתח את הארון ✓':'מנוע AI מוכן לשימוש');}catch(e){$('outfitNote').textContent='הסטייליסט לא זמין כרגע. אפשר ליצור לוק רגיל; הבגדים שמורים.';status(friendlyAIError(e));toast(friendlyAIError(e))}finally{btn.disabled=false}}

  function editItem(itemId){const item=items.find(x=>x.id===itemId);if(!item)return;$('editId').value=item.id;$('editName').value=item.name||'';$('editType').value=item.type;$('editFit').value=item.fit;$('editWeather').value=item.wx;$('editSuggestion').textContent=item.aiVision?'הצעת AI לסוג: '+item.aiVision.type:'';$('editDialog').showModal()}
  function downloadBlob(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000)}
  function downloadSource(){const root=document.documentElement.cloneNode(true);root.querySelector('#grid').innerHTML='';root.querySelector('#outfit').innerHTML='';root.querySelector('#demoResult').innerHTML='';root.querySelector('#preview').hidden=true;root.querySelector('#previewImg').removeAttribute('src');root.querySelector('#photoActions').hidden=true;root.querySelector('#toast').textContent='';root.querySelectorAll('input').forEach(x=>{if(x.type!=='checkbox')x.removeAttribute('value')});root.querySelectorAll('.screen').forEach(x=>x.classList.toggle('on',x.id==='closet'));root.querySelector('#startupNotice').hidden=false;root.querySelector('#startupNotice').textContent='טוען את הארון…';downloadBlob(new Blob(['<!doctype html>\n'+root.outerHTML],{type:'text/html;charset=utf-8'}),'index.html')}
  async function selfTest(){const btn=$('testAI');btn.disabled=true;$('demoResult').replaceChildren();try{status('טוען תמונת מכנסיים ציבורית לבדיקת AI…');const response=await fetch(SAMPLE_URL,{signal:AbortSignal.timeout(30000)});if(!response.ok)throw Error('תמונת הבדיקה לא נטענה');const source=await normalizePhoto(await response.blob());const cutout=await runAI('segment',source);const result=await blurBackground(source,cutout);for(const [label,image]of [['לפני',source],['אחרי טשטוש AI',result.image]]){const figure=document.createElement('figure'),img=document.createElement('img'),caption=document.createElement('figcaption');img.src=image;img.alt=label;caption.textContent=label;figure.append(img,caption);$('demoResult').append(figure)}$('demoResult').dataset.result='passed';$('demoResult').dataset.coverage=result.coverage.toFixed(4);status('בדיקת AI הצליחה: המכנסיים זוהו והרקע טושטש ✓',100)}catch(e){$('demoResult').dataset.result='failed';status(friendlyAIError(e));console.error(e)}finally{btn.disabled=false}}

  document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>show(t.dataset.tab)));
  $('fab').addEventListener('click',()=>show('add'));$('openAI').addEventListener('click',()=>show('ai'));
  document.querySelectorAll('.chips').forEach(group=>group.addEventListener('click',e=>{const chip=e.target.closest('.chip');if(!chip)return;group.querySelectorAll('.chip').forEach(c=>{c.classList.toggle('on',c===chip);c.setAttribute('aria-pressed',String(c===chip))});if(group.id==='filter')renderCloset()}));
  for(const inputId of ['shoot','gallery'])$(inputId).addEventListener('change',e=>{const files=Array.from(e.target.files||[]);e.target.value='';void handleFiles(files)});
  $('clearPhoto').addEventListener('click',()=>{lastPhotoId=null;updatePreview();saveStatus('כל תמונה נשמרת אוטומטית. בחרו סוג ואז צלמו או העלו תמונה.')});
  $('openCloset').addEventListener('click',()=>show('closet'));$('removeBg').addEventListener('change',()=>toast('ההגדרה תחול על התמונות הבאות'));
  $('retryPhoto').addEventListener('click',()=>retry(lastPhotoId));$('retryAll').addEventListener('click',async()=>{for(const item of items.filter(x=>x.aiStatus==='error'))await retry(item.id);if(!aiQueue.length&&!aiRunning)toast('אין תמונות שממתינות לניסיון נוסף')});
  $('classifyPhoto').addEventListener('click',async()=>{const btn=$('classifyPhoto');btn.disabled=true;try{const result=await classifyItem(lastPhotoId);if(result){status('הצעת זיהוי: '+result.type);toast('הזיהוי הוא הצעה — אפשר לקבל או לבחור סוג ידנית.')}}catch(e){status(friendlyAIError(e));toast(friendlyAIError(e))}finally{btn.disabled=false}});
  $('acceptVision').addEventListener('click',async()=>{const item=(await getAll()).find(x=>x.id===lastPhotoId);if(item?.aiVision){await put({...item,type:item.aiVision.type});await refresh();toast('סוג הבגד עודכן לפי הצעת ה-AI')}});
  $('grid').addEventListener('click',async e=>{const action=e.target.closest('button');if(!action)return;try{if(action.dataset.delete){const itemId=action.dataset.delete;const item=items.find(x=>x.id===itemId);if(!item)return;await remove(itemId);await refresh();$('undoDelete').hidden=false;$('undoDelete').onclick=async()=>{await put(item);await refresh();$('undoDelete').hidden=true;toast('הפריט הוחזר לארון')};toast('הפריט הוסר. אפשר לבטל את המחיקה.')}else if(action.dataset.edit)editItem(action.dataset.edit);else if(action.dataset.retry)await retry(action.dataset.retry);else if(action.dataset.original){const item=items.find(x=>x.id===action.dataset.original),img=action.closest('.item').querySelector('img');const original=img.dataset.original!=='true';img.src=original?item.originalImg:item.img;img.dataset.original=String(original);action.textContent=original?'הצג טשטוש':'הצג מקור'}}catch(e){toast('הפעולה לא נשמרה: '+e.message)}});
  $('editForm').addEventListener('submit',async e=>{e.preventDefault();try{const item=(await getAll()).find(x=>x.id===$('editId').value);if(item){await put({...item,name:$('editName').value.trim().slice(0,80),type:$('editType').value,fit:$('editFit').value,wx:$('editWeather').value});await refresh();$('editDialog').close();toast('פרטי הבגד נשמרו')}}catch(e){toast('העריכה לא נשמרה: '+e.message)}});$('cancelEdit').addEventListener('click',()=>$('editDialog').close());
  $('make').addEventListener('click',()=>buildOutfit(false));$('smart').addEventListener('click',()=>buildOutfit(true));$('testAI').addEventListener('click',selfTest);
  $('downloadApp').addEventListener('click',downloadSource);$('backup').addEventListener('click',async()=>{await ready;downloadBlob(new Blob([JSON.stringify({version:2,items:await getAll()},null,2)],{type:'application/json'}),'wardrobe-backup.json')});
  $('importBackup').addEventListener('change',async e=>{const file=e.target.files[0];e.target.value='';if(!file)return;try{await ready;if(file.size>100*1024*1024)throw Error('הגיבוי גדול מ-100MB');const parsed=JSON.parse(await file.text()),list=Array.isArray(parsed)?parsed:parsed.items;if(!Array.isArray(list)||list.length>1000)throw Error('קובץ גיבוי לא תקין');const normalized=list.map(normalizeLegacy);if(normalized.some(x=>!x))throw Error('הגיבוי מכיל תמונות או פריטים לא תקינים');for(const item of normalized){item.id='import-'+item.id;await put(item)}await refresh();toast('הגיבוי יובא: '+normalized.length+' פריטים')}catch(e){toast('הגיבוי לא יובא במלואו: '+e.message)}});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden&&storageMode!=='none')void refresh()});
  window.addEventListener('pagehide',()=>resetWorker('העיבוד הושהה. התמונה שמורה וניתן לנסות שוב.'));
  show('closet');
})();

</script>
